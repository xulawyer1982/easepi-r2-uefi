#!/bin/busybox sh
# =============================================================================
#  fxrecovery for EasePi R2 · init
#
#  链路：BootROM → idblock(SPL+ATF) → EDK2 UEFI → GRUB → 本 initramfs → 网页刷机
#
#  与旧的 U-Boot 版本相比，唯一的差异是"启动分区"的判定依据：
#  以前找 extlinux/extlinux.conf，现在找 EFI/BOOT/BOOTAA64.EFI（ESP 分区）。
#  其余逻辑（网卡、DHCP、内存盘、服务守护）完全复用。
# =============================================================================
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s /bin 2>/dev/null

mount -t proc     proc   /proc     2>/dev/null
mount -t sysfs    sysfs  /sys      2>/dev/null
mount -t devtmpfs devtmpfs /dev    2>/dev/null
[ -e /dev/null ] || mdev -s 2>/dev/null
mkdir -p /dev/pts /tmp /run /images /mnt /media/probe
mount -t devpts devpts /dev/pts 2>/dev/null

# ---- 控制台：同时输出到串口与本地屏幕 -------------------------------------
CONSOLE=/dev/console
[ -c /dev/ttyS2 ] && CONSOLE=/dev/ttyS2
say() { echo "$*"; echo "$*" > "$CONSOLE" 2>/dev/null; }

say ""
say "=============================================================="
say "  fxrecovery for EasePi R2 (RK3588, UEFI 引导)"
say "  正在启动刷机环境，请稍候 ..."
say "=============================================================="

# ---- 内核模块：网卡在这套核里是模块，必须显式加载 -------------------------
for m in r8169 realtek dwmac-rk stmmac-platform stmmac pcs_xpcs; do
  modprobe "$m" 2>/dev/null
done
mdev -s 2>/dev/null

# ---- 定位启动分区（承载本 recovery 的那个 ESP）---------------------------
BOOTDEV=""
for a in $(cat /proc/cmdline); do
  case "$a" in fxboot=*) BOOTDEV="${a#fxboot=}" ;; esac
done

find_boot_part() {
  # 遍历块设备分区，找到带 UEFI 引导文件的 ESP
  for d in /sys/class/block/*; do
    n=$(basename "$d")
    case "$n" in
      *p[0-9]*|[a-z]*[0-9]) ;;
      *) continue ;;
    esac
    [ -b "/dev/$n" ] || continue
    if mount -t vfat -o ro "/dev/$n" /media/probe 2>/dev/null; then
      if [ -f /media/probe/EFI/BOOT/BOOTAA64.EFI ] || \
         [ -f /media/probe/EFI/BOOT/grub.cfg ] || \
         [ -f /media/probe/fx-recovery.tag ]; then
        echo "/dev/$n"; umount /media/probe; return 0
      fi
      umount /media/probe
    fi
  done
  return 1
}

[ -n "$BOOTDEV" ] || BOOTDEV="$(find_boot_part)"
if [ -n "$BOOTDEV" ]; then
  echo "$BOOTDEV" > /run/fxboot
  say "  启动分区: $BOOTDEV"
else
  say "  ⚠ 未定位到启动分区，上传镜像只能留在内存盘"
fi

# ---- 镜像存放 -------------------------------------------------------------
if [ -n "$BOOTDEV" ]; then
  if mount -t vfat -o rw,umask=0022 "$BOOTDEV" /mnt 2>/dev/null; then
    mkdir -p /mnt/images
    say "  持久仓库: $BOOTDEV → /mnt/images"
  fi
fi

# /images 用内存盘：网页上传的镜像落这里，不受 ESP 容量限制
MEM_MB=$(awk '/MemTotal/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
[ -z "$MEM_MB" ] && MEM_MB=2048
IMG_MB=$(( MEM_MB * 55 / 100 ))
[ "$IMG_MB" -lt 1024 ] && IMG_MB=1024
[ "$IMG_MB" -gt 8192 ] && IMG_MB=8192
mkdir -p /images
if mount -t tmpfs -o size=${FX_IMAGES_SIZE:-${IMG_MB}M} tmpfs /images 2>/dev/null; then
  say "  上传目录: /images（内存盘 ${FX_IMAGES_SIZE:-${IMG_MB}M}，重启清空）"
elif [ -d /mnt/images ]; then
  mount --bind /mnt/images /images 2>/dev/null
  say "  上传目录: /images（内存不足，改用启动分区）"
fi

# ---- 网络 ----------------------------------------------------------------
ip link set lo up 2>/dev/null
for i in /sys/class/net/*; do
  n=$(basename "$i")
  [ "$n" = "lo" ] && continue
  ip link set "$n" up 2>/dev/null
done

say "  正在通过 DHCP 获取地址 ..."
got=0
for i in /sys/class/net/*; do
  n=$(basename "$i")
  [ "$n" = "lo" ] && continue
  if udhcpc -i "$n" -q -t 5 -T 3 -s /etc/udhcpc.sh >/dev/null 2>&1; then
    got=1
    say "  $n: 已获取地址"
  fi
done

if [ "$got" -eq 0 ]; then
  first=""
  for i in /sys/class/net/eth* /sys/class/net/en*; do
    [ -e "$i" ] || continue
    first=$(basename "$i"); break
  done
  if [ -n "$first" ]; then
    # 回退不用任何写死的内网网段：优先取内核参数 fx.static_ip=a.b.c.d/nn，否则用链路本地地址
    ssip=$(sed -n 's/.*fx\.static_ip=\([^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null)
    if [ -n "$ssip" ]; then
      ip addr add "$ssip" dev "$first" 2>/dev/null && \
        say "  使用内核参数 fx.static_ip: $first = $ssip"
    fi
    ip addr add 169.254.1.1/16 dev "$first" 2>/dev/null && \
      say "  DHCP 失败，回退链路本地地址: $first = 169.254.1.1/16"
  fi
fi

# ---- 汇总访问地址 --------------------------------------------------------
URLS=""
for a in $(ip -4 addr show 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1); do
  case "$a" in 127.*) continue ;; esac
  URLS="$URLS http://$a/"
done

say ""
say "--------------------------------------------------------------"
say "  网页刷机控制台已就绪，请在浏览器打开："
for u in $URLS; do say "      $u"; done
[ -z "$URLS" ] && say "      （未取到 IP，请插好网线后重启，或用串口登录手动配置）"
say "--------------------------------------------------------------"
say ""

# ---- 生成"启动已装系统"的 GRUB 菜单 ---------------------------------------
#  刷进 NVMe/SATA 的系统如果是 U-Boot 系的（飞牛 / ophub / Armbian 的 ARM 镜像），
#  盘上没有 EFI 引导器，GRUB 的 chainload 扫不到它。这里改为读目标系统自己的
#  extlinux.conf，按它写的内核 / dtb / initrd / cmdline 生成一条 GRUB 菜单写回 ESP。
#  => 固件不绑定内核版本：飞牛换成新内核，只要它的 extlinux.conf 更新了，这里就跟着变。
gen_boot_menu() {
  [ -n "$BOOTDEV" ] || return 0
  mkdir -p /mnt/boot/grub 2>/dev/null || return 0
  OUT=/mnt/boot/grub/fxboot.cfg
  TMP=/tmp/fxboot.cfg.$$
  : > "$TMP"
  n=0

  for d in /sys/class/block/*; do
    p=$(basename "$d")
    case "$p" in
      *p[0-9]*|*[0-9]) ;;
      *) continue ;;
    esac
    [ -b "/dev/$p" ] || continue
    [ "/dev/$p" = "$BOOTDEV" ] && continue

    for fs in ext4 btrfs f2fs ext2 vfat; do
      # 只读挂载，且带 noatime：这个是 15 秒一次的轮询，不能给它任何写理由
      mount -t "$fs" -o ro,noatime "/dev/$p" /media/probe 2>/dev/null || continue

      conf=""
      for c in /media/probe/boot/extlinux/extlinux.conf \
               /media/probe/extlinux/extlinux.conf; do
        [ -f "$c" ] && conf="$c" && break
      done

      if [ -n "$conf" ]; then
        kpath=""; ipath=""; fpath=""; cmd=""
        while IFS= read -r line; do
          key=$(echo "$line" | tr 'A-Z' 'a-z' | awk '{print $1}')
          case "$key" in
            kernel|linux)  kpath=$(echo "$line" | awk '{print $2}') ;;
            initrd)        ipath=$(echo "$line" | awk '{print $2}') ;;
            fdt|devicetree|devicetreedir)
                           fpath=$(echo "$line" | awk '{print $2}') ;;
            append)        cmd=$(echo "$line" | cut -s -d' ' -f2-) ;;
          esac
        done < "$conf"

        if [ -n "$kpath" ]; then
          uuid=$(blkid -s UUID -o value "/dev/$p" 2>/dev/null)
          if [ -n "$uuid" ]; then
            n=$((n + 1))
            {
              echo "# 由 fxrecovery 自动生成：$p（目标系统自己的内核，固件不介入版本）"
              echo "menuentry '启动已安装的系统 ($p)' --id=installed$n {"
              echo "    insmod part_gpt"
              echo "    insmod part_msdos"
              echo "    insmod ext2"
              echo "    insmod btrfs"
              echo "    insmod f2fs"
              echo "    insmod search"
              echo "    search --no-floppy --fs-uuid --set=root $uuid"
              echo "    linux $kpath $cmd"
              [ -n "$fpath" ] && echo "    devicetree $fpath"
              [ -n "$ipath" ] && echo "    initrd $ipath"
              echo "}"
            } >> "$TMP"
          fi
        fi
      fi
      umount /media/probe 2>/dev/null
      # 挂载成功就说明文件系统类型已经定了，别再拿剩下 4 种类型去试挂同一个分区
      break
    done
  done

  # 只在内容变了才写，否则轮询每 15 秒刷一次屏
  if [ "$n" -gt 0 ] && ! cmp -s "$TMP" "$OUT" 2>/dev/null; then
    cat "$TMP" > "$OUT"
    sync
    say "  已写入 GRUB 引导项 $n 条 → /boot/grub/fxboot.cfg（重启即可见）"
  fi
  rm -f "$TMP"
}

# ---- 可选的擦盘请求 -------------------------------------------------------
#  用法：在 SD 卡的 ESP（Mac/Win 都能直接读写的 FAT 分区）根目录放一个
#        fx-wipe-<盘名>.txt，例如 fx-wipe-mmcblk0.txt
#  目的：清掉 eMMC 上的原厂 idbloader 和旧系统，让 BootROM 转而去引导 SD 卡。
#  盘名必须写在文件名里 —— 不接受"擦全部"这种写法，避免一次误伤多块盘。
#  文件内容第一行：留空或 head = 只擦前 8 MiB（默认，够破坏 idblock + 分区表）
#                            full = 全盘擦（大容量盘要几分钟）
disk_of() {
  b=$(basename "$1")
  case "$b" in
    # mmcblk0p1 -> mmcblk0 ; nvme0n1p2 -> nvme0n1 ; 但 mmcblk0 / nvme0n1 本身不动
    mmcblk*|nvme*|loop*)
      case "$b" in
        *p[0-9]*) echo "/dev/${b%p*}" ;;
        *)        echo "/dev/$b" ;;
      esac
      ;;
    # sda1 -> sda ; vda12 -> vda
    *[0-9]) echo "/dev/$(echo "$b" | sed 's/[0-9]*$//')" ;;
    *)      echo "/dev/$b" ;;
  esac
}

run_wipe_requests() {
  [ -n "$BOOTDEV" ] || return 0
  BOOTDISK=$(disk_of "$BOOTDEV")

  for f in /mnt/fx-wipe-*.txt; do
    [ -f "$f" ] || continue
    d=$(basename "$f" | sed 's/^fx-wipe-//; s/\.txt$//')
    [ -n "$d" ] || continue
    tgt="/dev/$d"

    if [ ! -b "$tgt" ]; then
      say "  擦盘请求跳过：$tgt 不是块设备"
      continue
    fi
    if [ "$tgt" = "$BOOTDISK" ]; then
      say "  拒绝擦除 $tgt —— 那是本次启动用的盘，擦了就再也起不来"
      mv "$f" "${f%.txt}.refused" 2>/dev/null
      continue
    fi
    if [ "$tgt" = "$BOOTDEV" ]; then
      say "  拒绝擦除 $tgt —— 那是本次启动用的分区"
      mv "$f" "${f%.txt}.refused" 2>/dev/null
      continue
    fi

    # 该盘若有分区被挂着，先卸掉再擦
    awk -v d="$tgt" '$1 ~ "^"d {print $2}' /proc/mounts 2>/dev/null |
      while read -r m; do umount "$m" 2>/dev/null; done

    mode=$(head -n 1 "$f" 2>/dev/null | tr -d ' \t\r')
    [ -n "$mode" ] || mode=head

    say "  收到擦盘请求：$tgt（模式 $mode）"
    if [ "$mode" = "full" ]; then
      say "  全盘擦除中，大容量盘需要几分钟..."
      if dd if=/dev/zero of="$tgt" bs=1048576 2>/dev/null; then
        say "  $tgt 全盘擦除完成"
      else
        say "  $tgt 全盘擦除未跑完（看 dmesg）"
      fi
    else
      if dd if=/dev/zero of="$tgt" bs=1048576 count=8 2>/dev/null; then
        say "  $tgt 前 8 MiB 已清零（idblock + 分区表已废）"
      else
        say "  $tgt 擦除失败"
      fi
    fi
    sync

    # 改名，防止下一次开机重复擦
    mv "$f" "${f%.txt}.done" 2>/dev/null
    say "  请求文件已改名 $(basename "${f%.txt}.done")，重启不会再擦"
  done
}
run_wipe_requests

# 后台轮询：刷完系统不必再多重启一次。写盘结束后下一次扫描就会把菜单写回 ESP。
gen_boot_menu
(
  while true; do
    sleep 15
    gen_boot_menu
  done
) &

# ---- 启动服务（带守护，异常退出自动拉起）---------------------------------
(
  while true; do
    /fxrecovery >>/tmp/fxrecovery.log 2>&1
    sleep 2
  done
) &

# ---- 串口/本地终端给一个可用 shell，便于排障 -----------------------------
say "按回车进入 shell（可执行 ip a / dmesg / lsblk）"
setsid sh -c 'exec sh </dev/tty1 >/dev/tty1 2>&1' 2>/dev/null
[ -c /dev/ttyS2 ] && setsid sh -c 'exec sh </dev/ttyS2 >/dev/ttyS2 2>&1' 2>/dev/null

# 保持 PID 1 存活并回收僵尸
while true; do
  sleep 3600 &
  wait $!
done
